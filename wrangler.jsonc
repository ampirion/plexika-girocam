{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "plexika-girocam",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-01",
  "workers_dev": true,
  "observability": {"enabled": false},
  "durable_objects": {
    "bindings": [{"name": "ROOMS", "class_name": "PlexikaRoom"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["PlexikaRoom"]}],
  "rules": [{"type": "Text", "globs": ["**/*.html"], "fallthrough": true}],
  "vars": {"ALLOWED_ORIGINS": "https://ampirion.github.io"}
}
